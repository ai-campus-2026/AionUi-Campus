# DashScope API Key（必填）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# Embedding 模型
EMBEDDING_MODEL=text-embedding-v4

# ChromaDB 数据持久化目录
CHROMA_PERSIST_DIR=./chroma_data

# 文档分块参数（字符数）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索参数（两阶段：混合召回 + 重排序精排）
# TOP_K: 精排后实际返回给 Agent 的文档块数量
TOP_K=5
# RECALL_TOP_N: 粗召回窗口大小（须显著大于 TOP_K，否则精排没有意义）
RECALL_TOP_N=20
# SCORE_THRESHOLD: 粗召回阶段的余弦下限，仅宽松粗筛「明显无关」，真正的过滤交给 RERANK_THRESHOLD
SCORE_THRESHOLD=0.1
# RERANK_THRESHOLD: 精排分数下限，低于该值的块不返回（rerank 降级时回退用 SCORE_THRESHOLD）
# 0.25 由真实知识库实测标定：无关问题最高分 0.1943，相关问题最低通过分 0.3076，取间隙中点
RERANK_THRESHOLD=0.25

# 重排序模型（gte-rerank-v2 分离度干净；qwen3-rerank 备选；gte-rerank v1 已下线勿用）
RERANK_MODEL=gte-rerank-v2
RERANK_ENABLED=true
RERANK_MAX_DOCS=500
RERANK_MAX_RETRIES=2
# HTTP 读超时（秒）。SDK 默认 300 秒对交互式检索过长，收紧到 30
RERANK_TIMEOUT=30

# BM25 关键词召回（补足文号/条款号/数字阈值等精确 token）
BM25_ENABLED=true
RRF_K=60

# Embedding 批大小与失败重试次数
EMBED_BATCH_SIZE=10
EMBED_MAX_RETRIES=3

# 日志级别（DEBUG/INFO/WARNING/ERROR），日志输出到 stderr
LOG_LEVEL=INFO
