# Keep values local. Never commit API keys or personal attachment paths.
# The server reads only the exact PDF/image attachment_path from a tool call.
# It never scans folders or accepts a directory as an attachment.

# Optional persistent location for shared curriculum plans. If absent, the
# server uses ./curriculum_knowledge_base next to server.py.
CURRICULUM_KNOWLEDGE_BASE_DIR=./curriculum_knowledge_base

# Optional private, anonymous pass/fail state store. Defaults to
# ./student_progress; never share this directory with the curriculum library.
COURSE_PATH_PROGRESS_DIR=./student_progress

# Optional local model overrides for experiments. Leave blank to use the
# team defaults in data/model_config.json.
COURSE_PATH_OCR_MODEL=
COURSE_PATH_REVIEW_MODEL=

# Curriculum-only semantic retrieval. The collection is always isolated as
# curriculum_documents inside the curriculum knowledge-base directory.
EMBEDDING_MODEL=text-embedding-v4
CURRICULUM_SCORE_THRESHOLD=0.3
# Remote query embeddings are opt-in. Local curriculum search remains fast
# and deterministic when this is false or absent.
CURRICULUM_SEMANTIC_FALLBACK=false

# Used only at runtime by the DashScope extraction adapter.
DASHSCOPE_API_KEY=
